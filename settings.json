{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "language": "spanish",
  "permissions": {
    "allow": [
      "Read(./**)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(pip *)",
      "Bash(conda *)",
      "Bash(pytest *)",
      "Bash(node *)",
      "Bash(npm install*)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Read(./SAS dataset/**)",
      "Read(**/*.sas7bdat)",
      "Read(**/*_dataset.csv)",
      "Read(**/*_dataset.parquet)",
      "Read(./.env*)",
      "Read(./secrets/**)"
    ]
  }
}
